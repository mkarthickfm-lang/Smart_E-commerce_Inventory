    "#inventory_analyzer.py\n",
    "\n",
    "class Product:\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        product_id,\n",
    "        name,\n",
    "        category,\n",
    "        price,\n",
    "        stock,\n",
    "        daily_sales,\n",
    "        reorder_level,\n",
    "        supplier_lead_time\n",
    "    ):\n",
    "        self.product_id = product_id\n",
    "        self.name = name\n",
    "        self.category = category\n",
    "        self.price = price\n",
    "        self.stock = stock\n",
    "        self.daily_sales = daily_sales\n",
    "        self.reorder_level = reorder_level\n",
    "        self.supplier_lead_time = supplier_lead_time\n",
    "\n",
    "    def days_of_stock(self):\n",
    "\n",
    "        if self.daily_sales == 0:\n",
    "            return float(\"inf\")\n",
    "\n",
    "        return self.stock / self.daily_sales\n",
    "\n",
    "    def inventory_value(self):\n",
    "\n",
    "        return self.stock * self.price\n",
    "\n",
    "    def risk_level(self):\n",
    "\n",
    "        days_left = self.days_of_stock()\n",
    "\n",
    "        if self.stock <= self.reorder_level:\n",
    "            return \"HIGH\"\n",
    "\n",
    "        elif days_left <= self.supplier_lead_time:\n",
    "            return \"MEDIUM\"\n",
    "\n",
    "        else:\n",
    "            return \"LOW\"\n",
    "\n",
    "    def reorder_recommendation(self):\n",
    "\n",
    "        days_left = self.days_of_stock()\n",
    "\n",
    "        if days_left == float(\"inf\"):\n",
    "            return \"No reorder needed\"\n",
    "\n",
    "        if days_left <= self.supplier_lead_time:\n",
    "            required_stock = (\n",
    "                self.daily_sales * self.supplier_lead_time\n",
    "            )\n",
    "\n",
    "            reorder_quantity = max(\n",
    "                0,\n",
    "                int(required_stock - self.stock)\n",
    "            )\n",
    "\n",
    "            return f\"Reorder {reorder_quantity} units\"\n",
    "\n",
    "        return \"Stock level is healthy\"\n",
    "\n",
    "    def display(self):\n",
    "\n",
    "        days_left = self.days_of_stock()\n",
    "\n",
    "        print(f\"Product ID       : {self.product_id}\")\n",
    "        print(f\"Product Name     : {self.name}\")\n",
    "        print(f\"Category         : {self.category}\")\n",
    "        print(f\"Price            : ₹{self.price}\")\n",
    "        print(f\"Current Stock    : {self.stock}\")\n",
    "        print(f\"Daily Sales      : {self.daily_sales}\")\n",
    "        print(f\"Days of Stock    : {days_left:.1f}\")\n",
    "        print(f\"Risk Level       : {self.risk_level()}\")\n",
    "        print(f\"Inventory Value  : ₹{self.inventory_value():,.2f}\")\n",
    "        print(f\"Recommendation   : {self.reorder_recommendation()}\")\n",
    "\n",
    "        print (\"\\n----------------------------------\")\n",
    "\n",
    "class InventoryManager:\n",
    "\n",
    "    def __init__(self):\n",
    "        self.products = []\n",
    "\n",
    "    def add_product(self, product):\n",
    "\n",
    "        self.products.append(product)\n",
    "\n",
    "    def save_to_json(self, filename):\n",
    "\n",
    "        data = []\n",
    "\n",
    "        for product in self.products:\n",
    "\n",
    "            data.append({\n",
    "                \"product_id\": product.product_id,\n",
    "                \"name\": product.name,\n",
    "                \"category\": product.category,\n",
    "                \"price\": product.price,\n",
    "                \"stock\": product.stock,\n",
    "                \"daily_sales\": product.daily_sales,\n",
    "                \"reorder_level\": product.reorder_level,\n",
    "                \"supplier_lead_time\": product.supplier_lead_time\n",
    "            })\n",
    "\n",
    "        with open(filename, \"w\") as file:\n",
    "            json.dump(data, file, indent=4)\n",
    "\n",
    "    def show_inventory(self):\n",
    "\n",
    "        print(\"\\n===== SMART INVENTORY ANALYZER =====\")\n",
    "\n",
    "        for product in self.products:\n",
    "            product.display()\n",
    "\n",
    "\n",
    "def main():\n",
    "\n",
    "    inventory = InventoryManager()\n",
    "\n",
    "    products = [\n",
    "        Product(\n",
    "            \"P101\",\n",
    "            \"KRD Charcoal Soap\",\n",
    "            \"Beauty\",\n",
    "            120,\n",
    "            25,\n",
    "            5,\n",
    "            20,\n",
    "            7\n",
    "        ),\n",
    "\n",
    "        Product(\n",
    "            \"P102\",\n",
    "            \"KRD Goat Milk Soap\",\n",
    "            \"Beauty\",\n",
    "            130,\n",
    "            80,\n",
    "            3,\n",
    "            25,\n",
    "            5\n",
    "        ),\n",
    "\n",
    "        Product(\n",
    "            \"P103\",\n",
    "            \"KRD Pain Relief Oil\",\n",
    "            \"Healthcare\",\n",
    "            180,\n",
    "            12,\n",
    "            4,\n",
    "            15,\n",
    "            6\n",
    "        ),\n",
    "\n",
    "        Product(\n",
    "            \"P104\",\n",
    "            \"KRD Pain Balm\",\n",
    "            \"Healthcare\",\n",
    "            100,\n",
    "            150,\n",
    "            4,\n",
    "            30,\n",
    "            5\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    for product in products:\n",
    "        inventory.add_product(product)\n",
    "\n",
    "    inventory.show_inventory()\n",
    "\n",
    "    inventory.save_to_json(\"products.json\")\n",
    "\n",
    "    print(\"\\n----------------------------------\")\n",
    "    print(\"Inventory data saved successfully!\")\n",
    "    print(\"----------------------------------\")\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
